# AWS Credentials (선택사항 - S3/CloudFront 테스트시 필요)
AWS_IAM_ACCESSKEY=your-aws-access-key
AWS_IAM_SECRETKEY=your-aws-secret-key
CLOUDFRONT_KEY_PAIR_ID=your-cloudfront-key-pair-id
CLOUDFRONT_DOMAIN=your-cloudfront-domain
PRIVATE_KEY_PATH=/app/private_key.pem

# Firebase (선택사항 - 알림 테스트시 필요)
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json

# OAuth (선택사항 - 소셜 로그인 테스트시 필요)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret