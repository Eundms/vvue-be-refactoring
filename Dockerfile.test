FROM openjdk:17-slim

WORKDIR /app

# 빌드된 JAR 파일 복사
ARG JAR_FILE=build/libs/*.jar
COPY ${JAR_FILE} app.jar

# 테스트용 더미 파일 생성
RUN echo '{"type": "service_account"}' > /app/test-firebase.json && \
    echo '-----BEGIN PRIVATE KEY-----\ntest-key\n-----END PRIVATE KEY-----' > /app/test-private-key.pem

# 헬스체크 설정
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8080/back/api/actuator/health || exit 1

EXPOSE 8080

ENTRYPOINT ["java", "-Dspring.profiles.active=test", "-jar", "/app/app.jar"]